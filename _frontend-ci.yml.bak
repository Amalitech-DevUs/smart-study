# frontend-ci.yml — replace the steps block with:
steps:
  - name: Checkout code
    uses: actions/checkout@v4

  - name: Check for package.json
    id: check
    run: echo "exists=$([ -f frontend/package.json ] && echo true || echo false)" >> $GITHUB_OUTPUT

  - name: Set up Node
    if: steps.check.outputs.exists == 'true'
    uses: actions/setup-node@v4
    with:
      node-version: "20"
      cache: "npm"
      cache-dependency-path: frontend/package-lock.json

  - name: Install dependencies
    if: steps.check.outputs.exists == 'true'
    working-directory: frontend
    run: npm ci

  - name: Lint
    if: steps.check.outputs.exists == 'true'
    working-directory: frontend
    run: npm run lint --if-present

  - name: Build (Next.js)
    if: steps.check.outputs.exists == 'true'
    working-directory: frontend
    run: npm run build

  - name: Run tests
    if: steps.check.outputs.exists == 'true'
    working-directory: frontend
    run: npm test --if-present